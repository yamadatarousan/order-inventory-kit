# 開発用DB接続
DATABASE_URL=postgres://order_inventory:order_inventory@localhost:5434/order_inventory_dev?sslmode=disable

# フロントエンド開発サーバーのOrigin（カンマ区切りで複数指定可）
CORS_ALLOW_ORIGIN=http://localhost:5173

# テスト用DB接続（必要なら上書き）
TEST_DATABASE_URL=postgres://order_inventory:order_inventory@localhost:5434/order_inventory_test?sslmode=disable

# 期限切れ注文の戻し処理設定
# 期限定義: created_at + ORDER_EXPIRATION_TTL
ORDER_EXPIRATION_TTL=30m
# 判定タイミング: ORDER_EXPIRATION_INTERVAL ごと
ORDER_EXPIRATION_INTERVAL=1m
